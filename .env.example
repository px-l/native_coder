# Run with: node --env-file=.env dist/server/index.js
PORT=4317
# CODEX_BIN=/absolute/path/to/codex
# NATIVE_CODER_DATA=/absolute/path/to/local-data
# Reference repository is always read-only; never modified by this workbench.
# NATIVE_CODER_REFERENCE_REPO=/absolute/path/to/kedian-monorepo
# UIProof is a separate SSH-hosted MCP server. The alias must exist in ~/.ssh/config.
# UIPROOF_SSH_HOST=aliyun
# UIPROOF_REMOTE_COMMAND=/opt/uiproof/bin/mcp
# UIPROOF_TUNNEL_PORT=49317
